{
  "name": "@gtd/content-schema",
  "version": "0.0.1",
  "private": true,
  "description": "Schemas, loader and validator for stage packs.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "bin": {
    "gtd-validate-content": "src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "validate": "tsx src/cli.ts"
  },
  "dependencies": {
    "@gtd/sim": "0.0.1",
    "zod": "^4.1.12"
  }
}
